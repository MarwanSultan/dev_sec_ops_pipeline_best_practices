{
  "id": null,
  "uid": "test-framework-metrics",
  "title": "Test Framework Metrics",
  "tags": ["qa", "automation", "tests"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Total Test Runs",
      "targets": [{"expr": "test_runs_total", "legendFormat": "Runs"}],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6}
