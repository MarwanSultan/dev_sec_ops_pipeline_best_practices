    {
      "type": "stat",
      "title": "Total Test Failures",
      "targets": [{"expr": "test_failures_total", "legendFormat": "Failures"}],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6}
    },
    {
      "type": "stat",
      "title": "Test Duration (seconds)",
      "targets": [{"expr": "test_duration_seconds", "legendFormat": "Duration"}],
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 6}
    }
  ]
}
